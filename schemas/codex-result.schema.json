{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jxxghp/MoviePilot-Maintenance/blob/main/schemas/codex-result.schema.json",
  "title": "MoviePilot Codex maintenance result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "repository",
    "ref",
    "summary",
    "changed",
    "tests",
    "needs_human"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "no_change",
        "review_required",
        "blocked",
        "failed"
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "classification": {
      "type": "string",
      "maxLength": 120
    },
    "direction_assessment": {
      "type": "string",
      "maxLength": 12000
    },
    "changed": {
      "type": "boolean"
    },
    "branch": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    },
    "commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{7,64}$"
    },
    "pr": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "tests": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "result"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "result": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "unverified": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "needs_human": {
      "type": "boolean"
    },
    "human_action": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "notification": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "enabled",
        "sent"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sent": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    }
  }
}
